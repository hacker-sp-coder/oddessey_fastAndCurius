# ==========================================
# ScreenAI - Environment Configuration
# ==========================================

# --- Node.js API (backend/api) ---
NODE_ENV=development
PORT=4000
# When running with Docker Compose, AI_SERVICE_URL is set automatically to http://ai-service:8000
AI_SERVICE_URL=http://127.0.0.1:8000
DATABASE_PATH=../../storage/pitches.db
UPLOAD_DIR=../../storage/uploads
TEMP_DIR=../../storage/temp
FIXTURES_DIR=../../fixtures
MAX_FILE_SIZE_MB=100
CORS_ORIGIN=http://localhost:5173

# --- Python AI Service (backend/ai-service) ---
AI_PORT=8000
AI_HOST=0.0.0.0

# Providers: 'fallback' (safe CPU/no-key offline demo), 'groq', 'faster-whisper'
TRANSCRIPTION_PROVIDER=fallback

# Evaluators: 'deterministic' (safe offline heuristic rubric), 'groq'
EVALUATION_PROVIDER=deterministic

# Optional Groq Credentials (leave empty for deterministic offline execution)
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3

# Faster-Whisper local options (only if model installed)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Paths
TEMP_STORAGE_DIR=../../storage/temp
FIXTURES_DIR=../../fixtures

# --- Frontend (frontend) ---
# For Docker Nginx reverse proxy, leave empty or use /api. For direct local dev, use http://localhost:4000/api
VITE_API_BASE_URL=/api
